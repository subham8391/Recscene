# Account sign-in (docs/DECISIONS.md 2026-11-18): the Supabase project Recscene signs in against.
# Copy to `.env`; electron-vite bakes MAIN_VITE_* into the main process at build time.
# The anon key is public by design (row-level security protects the data).
MAIN_VITE_SUPABASE_URL=https://<project-ref>.supabase.co
MAIN_VITE_SUPABASE_ANON_KEY=<anon key from Project Settings › API>
