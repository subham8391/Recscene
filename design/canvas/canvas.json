    "t-mobile": {"x": 0, "y": 3520, "text": "Mobile · 390 × 844 — companion recorder and single-column editor", "kind": "title1", "maxW": 3200},
    "s-theme": {"x": 1460, "y": 0, "w": 420, "text": "Every artboard carries a \"theme\" tweak (dark / light). The light boards are the same file imported with theme=light, so the two modes can never drift apart. Dark is the default for the editor because footage and colour grading read best on a neutral graphite; light is the default for export, settings and the project list where text dominates.", "fill": "purple"},
    "s-tracks": {"x": 1460, "y": 320, "w": 420, "text": "Track colours are shared by all three breakpoints: Zooms purple, Clips yellow, Camera layouts pink, Masks teal, Shortcuts blue, Captions green, Voice-overs orange. Each pair also differs in lightness so it survives greyscale.", "fill": "blue"},
    "s-mobile": {"x": 1460, "y": 580, "w": 420, "text": "On mobile the inspector becomes a bottom sheet with 44 px targets, the sidebar becomes a tab bar, and the eight tracks collapse to a single scrubber strip with one row per enabled track. Recording on mobile is the companion role: start, stop, flag, countdown, speaker notes.", "fill": "orange"}
  },
