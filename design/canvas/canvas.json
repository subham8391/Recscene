    "t-ds": {
      "x": 0,
      "y": -280,
      "text": "Recscene \u2014 design system",
      "kind": "title1",
      "maxW": 1400
    },
    "t-laptop": {
      "x": 0,
      "y": 1180,
      "text": "Laptop \u00b7 1280 \u00d7 800 \u2014 the editor and every panel, recording, export, settings",
      "kind": "title1",
      "maxW": 4400
    },
    "t-tablet": {
      "x": 0,
      "y": 2360,
      "text": "Tablet \u00b7 1024 \u00d7 768 \u2014 two-pane editor, inspector as a sheet",
      "kind": "title1",
      "maxW": 3200
    },
    "t-mobile": {
      "x": 0,
      "y": 3520,
      "text": "Mobile \u00b7 390 \u00d7 844 \u2014 companion recorder and single-column editor",
      "kind": "title1",
      "maxW": 3200
    },
    "s-theme": {
      "x": 1460,
      "y": 0,
      "w": 420,
      "text": "Every artboard carries a \"theme\" tweak (dark / light). The light boards are the same file imported with theme=light, so the two modes can never drift apart. Dark is the default for the editor because footage and colour grading read best on a neutral graphite; light is the default for export, settings and the project list where text dominates.",
      "fill": "purple"
    },
    "s-tracks": {
      "x": 1460,
      "y": 320,
      "w": 420,
      "text": "Track colours are shared by all three breakpoints: Zooms purple, Clips yellow, Camera layouts pink, Masks teal, Shortcuts blue, Captions green, Voice-overs orange. Each pair also differs in lightness so it survives greyscale.",
      "fill": "blue"
    },
    "s-mobile": {
      "x": 1460,
      "y": 580,
      "w": 420,
      "text": "On mobile the inspector becomes a bottom sheet with 44 px targets, the sidebar becomes a tab bar, and the eight tracks collapse to a single scrubber strip with one row per enabled track. Recording on mobile is the companion role: start, stop, flag, countdown, speaker notes.",
      "fill": "orange"
    },
    "t-laptop2": {
      "x": 0,
      "y": 4720,
      "text": "Laptop \u00b7 the remaining areas \u2014 clips, shortcuts, captions, presets, 4.1.0 enhance, recording flow, shared page, account",
      "kind": "title1",
      "maxW": 4400
    },
    "s-coverage": {
      "x": 1460,
      "y": 820,
      "w": 420,
      "text": "Coverage: every one of the 292 specs now has a board. Row 1 editor panels + picker/export/settings/projects, row 4 the rest. Light variants of row-4 editor boards follow the same import pattern when needed.",
      "fill": "green"
    }
  },
