{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": { "@core/*": ["src/core/*"], "@renderer/*": ["src/renderer/src/*"] }
  },
  "include": ["src/renderer/src/**/*", "src/preload/index.d.ts", "src/core/**/*"]
}
